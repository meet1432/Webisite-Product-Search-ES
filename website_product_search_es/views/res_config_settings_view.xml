<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_es_search" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.es.search</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Elasticsearch Search" string="Elasticsearch Search" data-key="website_product_search_es">
                    <h2><i class="fa fa-search me-2"/>Elastic Search</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <i class="fa fa-database text-primary" title="Elasticsearch"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <field name="es_search_enabled" />
                                <label for="es_search_enabled" />
                                <div class="text-muted">
                                    Enable Elasticsearch search for website products.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane" />
                            <div class="o_setting_right_pane">
                                <label for="es_search_url" />
                                <div class="text-muted">Example: http://localhost:9200</div>
                                <field name="es_search_url" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane" />
                            <div class="o_setting_right_pane">
                                <label for="es_search_index" />
                                <field name="es_search_index" />
                                <div class="mt8">
                                    <button
                                        type="object"
                                        name="action_test_es_connection"
                                        class="btn btn-secondary"
                                        string="Test Elasticsearch Connection"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane" />
                            <div class="o_setting_right_pane">
                                <field name="es_hide_out_of_stock" />
                                <label for="es_hide_out_of_stock" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane" />
                            <div class="o_setting_right_pane">
                                <field name="es_enable_autocomplete" />
                                <label for="es_enable_autocomplete" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane" />
                            <div class="o_setting_right_pane">
                                <field name="es_enable_trending" />
                                <label for="es_enable_trending" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
